{
    "name": "openroad",
    "version": "1.0.0",
    "description": "Shared data layer for OpenRoad Data Tools: point storage, CSV import/export, and map helpers.",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/redmond2742/OpenRoad-Data-Tools.git"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./schema": {
            "types": "./dist/schema/schema.d.ts",
            "import": "./dist/schema/schema.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "esbuild index.ts schema/schema.ts --bundle --format=esm --platform=browser --packages=external --outdir=dist && tsc -p tsconfig.json",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.39.1",
        "drizzle-zod": "^0.7.0",
        "jszip": "^3.10.1",
        "nanoid": "^5.1.5",
        "tailwind-merge": "^2.6.0",
        "zod": "^3.24.2",
        "zustand": "^5.0.6"
    },
    "peerDependencies": {
        "react": "^18.3.1"
    },
    "publishConfig": {
        "access": "public"
    }
}
